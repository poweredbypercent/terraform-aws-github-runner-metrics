{
  "name": "terraform-aws-github-runner-metrics",
  "version": "0.1.0",
  "description": "Prometheus metrics for self-hosted GitHub Actions runner stacks built with terraform-aws-github-runner: queue depth and age, booting, busy and idle runners, capacity.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "zip": "node scripts/build.ts --zip",
    "typecheck": "tsc --noEmit",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write .",
    "docs:metrics": "node scripts/metric-docs.ts",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"e2e/**/*.e2e.test.ts\"",
    "test:bats": "bats modules/download-lambda",
    "verify": "npm run check && npm run typecheck && npm test && npm run test:bats && npm run zip",
    "prepare": "[ -n \"$CI\" ] || lefthook install"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "3.1147.0",
    "@aws-sdk/client-ec2": "3.1147.0",
    "@aws-sdk/client-secrets-manager": "3.1147.0",
    "@aws-sdk/client-sqs": "3.1147.0",
    "@aws-sdk/client-ssm": "3.1147.0",
    "@aws-sdk/credential-providers": "3.1147.0",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@smithy/types": "4.19.0",
    "@types/node": "22.20.5",
    "bats": "1.13.0",
    "esbuild": "0.28.2",
    "lefthook": "2.1.17",
    "typescript": "7.0.2"
  }
}
